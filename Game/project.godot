; Engine configuration file.
; BLOODLINE - side-on 3D fighting game for Android.

config_version=5

[application]

config/name="BLOODLINE"
config/description="Side-on 3D fighting game set in a world where the Veil bleeds through."
config/version="0.1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.025, 0.045, 1)
boot_splash/show_image=false

[autoload]

ContentDB="*res://scripts/core/ContentDB.gd"
SaveSystem="*res://scripts/core/SaveSystem.gd"
AudioDirector="*res://scripts/core/AudioDirector.gd"
SceneRouter="*res://scripts/core/SceneRouter.gd"

[debug]

; Godot 4.7 treats an inferred Variant type as an error, which stops the
; build on a style problem. The project keeps the warning visible but does
; not let it break the game.
gdscript/warnings/inference_on_variant=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/handheld/keep_screen_on=true

[input]

light_attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":74,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
